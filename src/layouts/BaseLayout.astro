		<meta name="generator" content={Astro.generator} />
		<title>mubin-thinks</title>
		<Font cssVariable="--font-gentium-book-plus"/>
		<Font cssVariable="--font-inconsolata"/>
	</head>
	<body
		class="
			box-border
			bg-off-white dark:bg-off-black
			font-display text-black dark:text-off-white
			p-8
		"
	>
        <slot />
	</body>
