---
import HeaderItem from "../components/HeaderItem.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainView from "../layouts/MainView.astro";
import {
    CodeXml,
    Feather,
} from "@lucide/astro";
---

<BaseLayout>
    <div class="flex flex-inital justify-center">
        <MainView>
            <div class="w-full flex justify-end mb-1">
                <ThemeToggle class="px-2 py-[0.25rem]"/>
            </div>
            <div class="w-full flex flex-col 2sm:flex-row 2sm:border-3 justify-between">
                <div
                    class="
                        font-display text-bold text-2xl
                        pl-2
                        border-3 2sm:border-none"
                >mubin-thinks</div>

                <div
                    class="
                        flex justify-end
                        border-l-3 border-r-3 border-b-3 2sm:border-none
                    "
                >
                    <HeaderItem href="/about-me">
                        <p
                            class="
                                font-display text-xl
                                underline decoration-2 dark:decoration-1
                            "
                        >about me</p>
                    </HeaderItem>
                    <HeaderItem href="/writings"><Feather /></HeaderItem>
                    <HeaderItem href="/projects"><CodeXml /></HeaderItem>
                    <HeaderItem href="https://github.com/mubin-thinks" newTab>
                        <img src="/GithubLogo.svg" class="w-(--text-2xl) dark:invert" />
                    </HeaderItem>
                </div>
            </div>
            <p class="mt-2 font-display text-lg text-justify">
                Hi, I'm a hobbiest low-level software developer and beginner graphics
                programmer. I am also passionate about Competitive Programming &amp;
                Programming Contests and have a lite taste on Web Development.
                Learn more{" "}
                <a class="underline decoration-2 dark:decoration-1" href="">
                    about me
                </a>.
            </p>
        </MainView>
    </div>
</BaseLayout>
